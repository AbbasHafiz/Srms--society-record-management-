# Copy to .env and edit. Never commit .env.
# Full Pakistan VPS walkthrough: docs/HOSTING-PAKISTAN.md

# --- App (Next.js + Prisma) ---
# Dev (Postgres on the host):
DATABASE_URL="postgresql://society:society_dev@localhost:5432/society_records?schema=public"
# Production Docker Compose uses the db service hostname, not localhost:
# DATABASE_URL="postgresql://society:CHANGE_ME_DB_PASSWORD@db:5432/society_records?schema=public"

AUTH_SECRET="replace-with-a-long-random-string"
# Optional alias some NextAuth docs still mention; this app reads AUTH_SECRET.
# NEXTAUTH_SECRET is not required if AUTH_SECRET is set.

# Optional: set only for a fixed single-host deployment (Docker, production).
# Leave unset in dev — trustHost derives the URL from each request (preview / tunnel).
# In production you MUST set NEXTAUTH_URL to the public https origin (used for QR codes).
# AUTH_URL="http://127.0.0.1:43127"
# NEXTAUTH_URL="http://127.0.0.1:43127"
# NEXTAUTH_URL="https://records.yoursociety.pk"

UPLOAD_DIR="./uploads"
# Production compose bind-mounts /var/srms/uploads and sets UPLOAD_DIR=/app/uploads.

MEMBERSHIP_PREFIX="M"
ALLOTMENT_PREFIX="AL"
TRANSFER_PREFIX="TRD"
FILE_PREFIX="PF"

# Optional WhatsApp Business API / webhook gateway (leave unset for wa.me deep links only)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# --- Production compose only (docker-compose.prod.yml / Caddy). Not read by Next.js. ---
# POSTGRES_USER="society"
# POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"
# POSTGRES_DB="society_records"
# SRMS_DOMAIN="records.yoursociety.pk"
# ACME_EMAIL="it@yoursociety.pk"
